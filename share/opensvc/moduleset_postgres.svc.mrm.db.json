                    "var_value": "{\"path\":\"%%ENV:SVC_CONF_ENV_BASE_DIR%%/%%ENV:POD%%/etc/postgresql/replication-manager.d/01_memory.conf\",\"mode\":\"%%ENV:CNF_PERMS%%\",\"uid\":\"%%ENV:MYSQL_UID%%\",\"gid\":\"%%ENV:MYSQL_GID%%\",\"fmt\":\"# memory, sized from the plan\\n\\nmax_connections = %%ENV:SVC_CONF_ENV_MAX_CONNECTIONS%%\\nshared_buffers = %%ENV:SVC_CONF_ENV_INNODB_BUFFER_POOL_SIZE%%MB\\neffective_cache_size = %%ENV:SVC_CONF_ENV_INNODB_BUFFER_POOL_SIZE%%MB\\nwork_mem = %%ENV:SVC_CONF_ENV_JOIN_BUFFER_SIZE%%MB\\ntemp_buffers = %%ENV:SVC_CONF_ENV_TMP_TABLE_SIZE%%MB\\nmaintenance_work_mem = %%ENV:SVC_CONF_ENV_MAX_SESSION_MEM_USED%%MB\\nmax_worker_processes = %%ENV:SVC_CONF_ENV_MAX_CORES%%\\nmax_parallel_workers = %%ENV:SVC_CONF_ENV_MAX_CORES%%\\neffective_io_concurrency = %%ENV:SVC_CONF_ENV_INNODB_READ_IO_THREADS%%\\n\\n\"}",
